# Android build artifacts (covers both android/ and platforms/android/)
(android|platforms/android)/app/build/
(android|platforms/android)/.gradle/
(android|platforms/android)/local.properties
(android|platforms/android)/build/
(android|platforms/android)/.cxx/
(android|platforms/android)/captures/
(android|platforms/android)/*.iml
(android|platforms/android)/app/*.iml
(android|platforms/android)/.idea/

# Android native libs (large binaries, extracted from npm at build time)
(android|platforms/android)/**/libs/cdvnodejsmobile/libnode/

# Android generated assets
(android|platforms/android)/**/app/src/main/assets/public
(android|platforms/android)/**/app/src/main/assets/capacitor.config.json
(android|platforms/android)/**/app/src/main/assets/capacitor.plugins.json
(android|platforms/android)/**/app/src/main/res/xml/config.xml

# Android web assets (built by esbuild / cap sync)
(android|platforms/android)/**/app/src/main/assets/www/

# Android all assets (完整忽略，由cap sync生成)
(android|platforms/android)/**/app/src/main/assets/

# Capacitor plugins (auto-generated, managed by cap sync)
(android|platforms/android)/capacitor-cordova-android-plugins/
packages/backend/workspaces

dev-tools/

# CMake/Native build artifacts
packages/backend/build-android-*/
packages/backend/build-vscode-*/
packages/backend/_build_temp/
packages/backend/native/
*.node

# npm lock files (project uses pnpm)
packages/backend/package-lock.json

# ============================================
# 🚫 防止调试文件污染（临时测试文件）
# ============================================

# 手动测试脚本
test-*.js
debug-session.spec.ts

# 测试截图和结果截图
test-*.png
debug-*.png
final-*.png
e2e-result*.png
screenshot_*.png

# 调试数据文件（DOM诊断、验证报告等）
debug-*.json
verification-*.json
full-diagnosis.json
debug-*.txt
pw-output.txt
ui_dump.xml

# Playwright 测试结果
test-results/

# 临时调试输出
*.tmp.debug.*
